{$DOMAIN} {
	encode zstd gzip

	# Guvenlik basliklari
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		-Server
	}

	# Uzun provider sorgulari icin genis zaman asimi
	reverse_proxy app:3000 {
		transport http {
			read_timeout 5m
			write_timeout 5m
		}
	}

	log {
		output stdout
		format json
	}
}
