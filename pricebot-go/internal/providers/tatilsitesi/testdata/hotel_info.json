   "HotelLocation": "<style>.oteldetayhr{margin:0 auto; width:75%;} .oteldetayfoto{  float:left; width:23%; margin:4px; padding:5px; border:1px solid #ddd;}</style>\n\n\n<div style=\"color:#666; line-height:24px;\"><p><span style=\"color: rgb(51, 51, 51); font-family: &quot;open sans&quot;, sans-serif; font-weight: bold; font-size: medium;\">\n\n\nKıbrıs'ta Girne-Çatalköy bölesinde hizmet veren Hotel, Ercan havalimanı'na 28 km, Girne şehir merkezine 8 km, Lefkoşa merkeze 28 km ve Gazi Mağusa merkeze 45 km. uzaklıkta konumlanıyor.\n\n</span></p><br>\n<div style=\"padding:15px;\">\n\t<h3 style=\"font-size:16px; font-weight:bold; color:#39ad52;\">Konum Özellikleri</h3><br>\n\n\n<p><span style=\"font-size:15px; font-style:italic; color:#444;\">\n<img src=\"/Content/img/hdt-location-icon.png\">\nErcan havalimanı'na 28 km. (20 dk) uzaklıkta konumlanıyor.\n</span> </p> <br>\n\n<p><span style=\"font-size:15px; font-style:italic; color:#444;\">\n<img src=\"/Content/img/hdt-location-icon.png\">\nGirne şehir merkezine 8 km (15dk.) uzaklıkta konumlanıyor.\n</span> </p> <br>\n\n<p><span style=\"font-size:15px; font-style:italic; color:#444;\">\n<img src=\"/Content/img/hdt-location-icon.png\">\nLefkoşa merkeze 28 km. uzaklıkta konumlanıyor.\n</span> </p> <br>\n\n<p><span style=\"font-size:15px; font-style:italic; color:#444;\">\n<img src=\"/Content/img/hdt-location-icon.png\">\nGazi Mağusa merkeze 45 km. uzaklıkta konumlanıyor.\n</span> </p> <br>\n\n\n</div>\n\n<br>\n\n\n\n<div style=\"clear:both;\"></div>\n\n\n</div>\n",
