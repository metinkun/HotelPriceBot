# Server
PORT=3000

# PostgreSQL (docker-compose icinde app servisi bunu kendi override eder)
DATABASE_URL="postgresql://botuser:botpass123@localhost:5434/pricebot"

# Admin API Key
ADMIN_API_KEY="your-secret-api-key-here"

# Provider cookies
ETSTUR_COOKIE=""
TATILSEPETI_COOKIE=""               # istege bagli override; bos ise oturum otomatik edinilir (bkz. docs/providers/tatilsepeti.md)
TATILSEPETI_VERIFICATION_TOKEN=""   # istege bagli override (sayfadaki #forgeryToken)

# Proxy (Webshare.io) - static fallback
PROXY_HOST=""
PROXY_PORT=0
PROXY_USERNAME=""
PROXY_PASSWORD=""

# Webshare.io Proxy Rotation
WEBSHARE_API_KEY=""
PROXY_SYNC_INTERVAL_MS=300000
BROWSER_PROXY_URL=""            # headless tarayici (Touristica) icin tek proxy: http://user:pass@host:port (Chrome istek basina donusum yapamaz)

# E-posta (sifre sifirlama linki). Bos ise link admin ekraninda gosterilir, e-posta gonderilmez.
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="SmartRate <no-reply@example.com>"
SMTP_TLS=                       # starttls (varsayilan) | tls (465) | none
PUBLIC_PORTAL_URL=              # orn. https://demo.smartrate.app/portal/  (bos: istekten turetilir)
PUBLIC_API_URL=                 # musteri paketindeki API adresi, orn. https://api.smartrate.app (bos: admin panelin adresi)
PASSWORD_RESET_TTL_MINUTES=60

# Headless tarayici (Touristica)
PUPPETEER_HEADLESS=true
BROWSER_EXECUTABLE_PATH=""

# ---- Production / Faz 0 ----
APP_ENV=development            # production -> JSON log, swagger kapali (SWAGGER_ENABLED ile acilir)
LOG_FORMAT=                    # json | text (bos: ortama gore)
CORS_ORIGINS=                  # virgulle; bos = *
SWAGGER_ENABLED=true
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=300
PROVIDER_CONCURRENCY=touristica=1,setur=3,default=5
BREAKER_FAILURES=5
BREAKER_OPEN_SECONDS=120
BROWSER_MAX_TABS=2
BROWSER_RESTART_AFTER=25
TOURISTICA_TABS=1              # kalici sekme sayisi (= eszamanli Touristica sorgusu); 4 GB sunucuda 2 onerilir
TOURISTICA_SESSION_MINUTES=20  # sekmedeki sayfa/oturum bu sureden sonra yenilenir
CANARY_HOTEL_ID=               # orn. htl_test1 (tum provider'lara gunluk kontrol sorgusu)
CANARY_INTERVAL_MINUTES=1440
JOB_RESULT_TTL_SECONDS=3600
JOB_MAX_QUEUED=200

# ---- Coklu musteri / admin paneli (Faz 2) ----
REQUIRE_API_KEY=false          # production'da varsayilan true: /api/prices*, /api/packages, /api/v1/* X-API-Key ister
JWT_SECRET=                    # admin oturumu imzasi (uzun rastgele). Bos ise ADMIN_API_KEY'den turetilir
ADMIN_EMAIL=                   # ilk admin (admin tablosu bossa olusturulur)
ADMIN_PASSWORD=
LOG_RETENTION_DAYS=30
DETAILS_RUN_HOUR=4               # otel statik detayi gunluk degisiklik kontrolu saati (Istanbul)
